<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL"
             xmlns:flowable="http://flowable.org/cmmn"
             targetNamespace="http://flowable.org/cmmn">
    <case id="repetitionWithJsonArray" name="Repetition with JSON array">
        <casePlanModel id="casePlanModel" name="Case plan model">
            <planItem id="planItem1" name="Task (${vars:getOrDefault('item', 'na')})" definitionRef="humanTask1">
                <itemControl>
                    <repetitionRule flowable:collectionVariable="myCollection" flowable:elementVariable="item" flowable:elementIndexVariable="itemIndex" />
                </itemControl>
            </planItem>
            <humanTask id="humanTask1" name="Task (${vars:getOrDefault('item', 'na')})" flowable:assignee="${item}" />
        </casePlanModel>
    </case>
</definitions>
