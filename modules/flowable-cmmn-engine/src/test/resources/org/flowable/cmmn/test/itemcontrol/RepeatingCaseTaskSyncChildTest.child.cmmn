<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/cmmn"
             targetNamespace="http://flowable.org/cmmn">

    <!-- A child case that completes synchronously: a single non-blocking task that
         immediately completes (mimics a child case with "just an init variable" task
         that has no wait state). -->
    <case id="immediateChildCase" name="Immediate child case">
        <casePlanModel id="childCpm" name="child plan model" flowable:autoComplete="true">
            <planItem id="childPi1" name="Init" definitionRef="childTask1"/>
            <task id="childTask1" name="Init" isBlocking="false"/>
        </casePlanModel>
    </case>

</definitions>
