<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://flowable.org/test">
    <process id="interceptorBpmnCaseTask" isExecutable="true">
        <startEvent id="start"/>
        <serviceTask id="childTask" flowable:type="case" flowable:caseDefinitionKey="interceptorChildCase">
            <extensionElements>
                <flowable:in source="orderId" target="orderId"/>
                <flowable:out source="reviewer" target="reviewer"/>
            </extensionElements>
        </serviceTask>
        <receiveTask id="wait"/>
        <endEvent id="end"/>
        <sequenceFlow id="flow1" sourceRef="start" targetRef="childTask"/>
        <sequenceFlow id="flow2" sourceRef="childTask" targetRef="wait"/>
        <sequenceFlow id="flow3" sourceRef="wait" targetRef="end"/>
    </process>
</definitions>
