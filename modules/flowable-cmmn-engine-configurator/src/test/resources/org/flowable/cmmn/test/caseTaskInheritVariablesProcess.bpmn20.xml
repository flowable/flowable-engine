<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://flowable.org/bpmn">

    <process id="inheritVariablesProcess">

        <startEvent id="theStart" />

        <sequenceFlow id="flow1" sourceRef="theStart" targetRef="caseServiceTask" />

        <serviceTask id="caseServiceTask" flowable:type="case" flowable:caseDefinitionKey="childCase" flowable:inheritVariables="true">
            <extensionElements>
                <flowable:in sourceExpression="${'overridden'}" target="parentVar2" />
            </extensionElements>
        </serviceTask>

        <sequenceFlow id="flow2" sourceRef="caseServiceTask" targetRef="theEnd" />

        <endEvent id="theEnd" />

    </process>

</definitions>
